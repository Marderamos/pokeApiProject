---
import Layout from '../layouts/Layout.astro';
import PokemonCard from '../components/PokemonCard.astro';
import type { PokemonListResponse } from '../interfaces/pokemon-list.response';
import type { Pokemon } from '../interfaces/pokemon.ts';

// Obtener lista de pokemons
const resp = await fetch('https://pokeapi.co/api/v2/pokemon?limit=20');
const data = (await resp.json()) as PokemonListResponse;

// Obtener detalles de cada pokemon (tipos) en paralelo
const pokemonDetails = await Promise.all(
	data.results.map(async ({name, url}) => {
		const id = url.split('/').at(-2);
		const detailResp = await fetch(`https://pokeapi.co/api/v2/pokemon/${id}`);
		const detail = (await detailResp.json()) as Pokemon;
		return {
			name, 
			url,
			types: detail.types.map(t => t.type.name)}
	} )
	
);
---


<Layout>
	<h1 class="text-3xl font-bold mb-2">Listado de Pokemons</h1>
	<p class="text-gray-400 mb-6">Explora los pokemones clásicos de la primera generación.</p>
		<section class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">

			{pokemonDetails.map(({name, url, types}) => (
				<PokemonCard name={name} url={url} types={types}/>
			))}

		</section>
</Layout>
